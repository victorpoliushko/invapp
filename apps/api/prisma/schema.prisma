generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  USER
}

model User {
  id                 String  @id @default(uuid())
  username           String  @unique
  password           String
  phoneNumber        String?
  email              String
  hashedRefreshToken String?
  role               Role    @default(USER)
  defaultCurrency    String  @default("USD")

  vault UserVault?

  settings         UserSettings?
  portfolios       Portfolio[]
  investStrategies InvestStrategy[]

  // TODO
  // ApiKey ApiKey[]
}

enum VaultMode {
  STANDARD
  PRIVATE
}

model UserVault {
  id                 String    @id @default(uuid())
  mode               VaultMode @default(PRIVATE)
  managedKey         String?
  salt               String?
  iterations         Int?
  wrappedKey         String?
  recoverySalt       String?
  recoveryWrappedKey String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

model UserSettings {
  id              String   @id @default(uuid())
  receiveSMS      Boolean?
  publicPortfolio Boolean?

  user   User?  @relation(fields: [userId], references: [id])
  userId String @unique
}

// TODO: fix stock type that comes from CSV
enum AssetType {
  BOND
  CASH
  COMMODITY
  CRYPTOCURRENCY
  ETF
  MUTUALFUND
  PRECIOUS_METAL
  PRIVATE_EQUITY
  Stock
}

enum DataSource {
  ALPHA_VANTAGE
  COINGECKO
  FINNHUB
}

model Asset {
  id             String      @id @default(uuid())
  ticker         String      @unique
  name           String?
  type           AssetType?
  exchange       String?
  dataSource     DataSource?
  coingeckoId    String?
  updatedAt      DateTime?   @updatedAt
  currentPrice   Float?
  priceUpdatedAt DateTime?

  stockPositions  StockPosition[]
  cryptoPositions CryptoPosition[]
}

model Portfolio {
  id              String  @id @default(uuid())
  name            String
  goal            String?
  displayCurrency String?

  user   User?  @relation(fields: [userId], references: [id])
  userId String

  stockPositions   StockPosition[]
  cryptoPositions  CryptoPosition[]
  realEstateAssets RealEstate[]
  bonds            Bond[]
  mixedAssets      MixedAsset[]
  cash             Cash[]
}

enum RealEstateType {
  APARTMENT
  HOUSE
  COMMERCIAL
  PARKING_LOT
  OTHER
}

model RealEstate {
  id            String         @id @default(uuid())
  code          String?
  name          String
  type          RealEstateType
  purchaseDate  DateTime
  purchasePrice String
  currentValue  String?
  rooms         Int?
  totalArea     Float?

  portfolio    Portfolio               @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  String
  transactions RealEstateTransaction[]
}

model RealEstateTransaction {
  id          String   @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  monthlyRent String

  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  realEstateId String
}

model StockPosition {
  portfolioId String
  assetId     String

  quantity String
  price    String?

  portfolio    Portfolio          @relation(fields: [portfolioId], references: [id])
  asset        Asset              @relation(fields: [assetId], references: [id])
  transactions StockTransaction[]

  @@id([portfolioId, assetId])
}

model CryptoPosition {
  portfolioId String
  assetId     String

  quantity String
  price    String?

  portfolio    Portfolio           @relation(fields: [portfolioId], references: [id])
  asset        Asset               @relation(fields: [assetId], references: [id])
  transactions CryptoTransaction[]

  @@id([portfolioId, assetId])
}

model InvestStrategy {
  id      String   @id @default(uuid())
  title   String
  tickers String[]

  user   User?  @relation(fields: [userId], references: [id])
  userId String
}

model MixedAsset {
  id            String   @id @default(uuid())
  name          String
  quantity      String
  purchasePrice String
  purchaseDate  DateTime @default(now())
  currentValue  String?

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId String
}

enum CashCategory {
  GENERAL
  STOCK
  CRYPTO
}

model Cash {
  id       String       @id @default(uuid())
  name     String?
  currency String
  amount   String
  category CashCategory @default(GENERAL)

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId String

  @@index([portfolioId])
}

model StockTransaction {
  id             String          @id @default(uuid())
  portfolioId    String
  assetId        String
  type           TransactionType
  quantityChange String
  pricePerUnit   String
  date           DateTime

  stockPosition StockPosition @relation(fields: [portfolioId, assetId], references: [portfolioId, assetId])

  @@index([id, portfolioId, assetId])
}

model CryptoTransaction {
  id             String          @id @default(uuid())
  portfolioId    String
  assetId        String
  type           TransactionType
  quantityChange String
  pricePerUnit   String
  date           DateTime

  cryptoPosition CryptoPosition @relation(fields: [portfolioId, assetId], references: [portfolioId, assetId])

  @@index([id, portfolioId, assetId])
}

enum TransactionType {
  BUY
  SELL
}

enum CouponFrequency {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  MONTHLY
}

model Bond {
  id              String          @id @default(uuid())
  isin            String
  name            String
  faceValue       String
  couponRate      String
  couponFrequency CouponFrequency
  currency        String          @default("USD")
  quantity        String
  purchasePrice   String
  currentValue    String?
  purchaseDate    DateTime        @default(now())
  maturityDate    DateTime?

  portfolio    Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  String
  transactions BondTransaction[]
}

model BondTransaction {
  id           String          @id @default(uuid())
  bondId       String
  type         TransactionType
  quantity     String
  pricePerUnit String
  date         DateTime

  bond Bond @relation(fields: [bondId], references: [id], onDelete: Cascade)

  @@index([bondId])
}

