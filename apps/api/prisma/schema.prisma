generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  USER
}

model User {
  id                 String  @id @default(uuid())
  username           String  @unique
  password           String
  phoneNumber        String?
  email              String
  hashedRefreshToken String?
  role               Role    @default(USER)

  settings         UserSettings?
  portfolios       Portfolio[]
  investStrategies InvestStrategy[]

  // TODO
  // ApiKey ApiKey[]
}

model UserSettings {
  id              String   @id @default(uuid())
  receiveSMS      Boolean?
  publicPortfolio Boolean?

  user   User?  @relation(fields: [userId], references: [id])
  userId String @unique
}

// TODO: fix stock type that comes from CSV
enum AssetType {
  BOND
  CASH
  COMMODITY
  CRYPTOCURRENCY
  ETF
  MUTUALFUND
  PRECIOUS_METAL
  PRIVATE_EQUITY
  Stock
}

enum DataSource {
  ALPHA_VANTAGE
  COINGECKO
}

model Asset {
  id              String      @id @default(uuid())
  ticker          String      @unique
  name            String?
  type            AssetType?
  exchange        String?
  dataSource      DataSource?
  coingeckoId     String?
  updatedAt       DateTime?   @updatedAt
  currentPrice    Float?
  priceUpdatedAt  DateTime?

  stockPositions  StockPosition[]
  cryptoPositions CryptoPosition[]
}

model Portfolio {
  id   String @id @default(uuid())
  name String
  goal Float?

  user   User?  @relation(fields: [userId], references: [id])
  userId String

  stockPositions   StockPosition[]
  cryptoPositions  CryptoPosition[]
  realEstateAssets RealEstate[]
  bonds            Bond[]
  mixedAssets      MixedAsset[]
}

enum RealEstateType {
  APARTMENT
  HOUSE
  COMMERCIAL
}

model RealEstate {
  id            String         @id @default(uuid())
  code          String
  name          String
  type          RealEstateType
  purchaseDate  DateTime
  purchasePrice Float
  currentValue  Float?
  rooms         Int?
  totalArea     Float?

  portfolio     Portfolio              @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId   String
  transactions  RealEstateTransaction[]
}

model RealEstateTransaction {
  id           String     @id @default(uuid())
  startDate    DateTime
  endDate      DateTime
  monthlyRent  Float

  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  realEstateId String
}

model StockPosition {
  portfolioId String
  assetId     String

  quantity Float
  price    Float?

  portfolio    Portfolio          @relation(fields: [portfolioId], references: [id])
  asset        Asset              @relation(fields: [assetId], references: [id])
  transactions StockTransaction[]

  @@id([portfolioId, assetId])
}

model CryptoPosition {
  portfolioId String
  assetId     String

  quantity Float
  price    Float?

  portfolio    Portfolio           @relation(fields: [portfolioId], references: [id])
  asset        Asset               @relation(fields: [assetId], references: [id])
  transactions CryptoTransaction[]

  @@id([portfolioId, assetId])
}

model InvestStrategy {
  id      String   @id @default(uuid())
  title   String
  tickers String[]

  user   User?  @relation(fields: [userId], references: [id])
  userId String
}

model MixedAsset {
  id            String    @id @default(uuid())
  name          String
  quantity      Float     @default(1)
  purchasePrice Float
  purchaseDate  DateTime  @default(now())
  currentValue  Float?

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId String
}

model StockTransaction {
  id             String          @id @default(uuid())
  portfolioId    String
  assetId        String
  type           TransactionType
  quantityChange Float
  pricePerUnit   Float
  date           DateTime

  stockPosition StockPosition @relation(fields: [portfolioId, assetId], references: [portfolioId, assetId])

  @@index([id, portfolioId, assetId])
}

model CryptoTransaction {
  id             String          @id @default(uuid())
  portfolioId    String
  assetId        String
  type           TransactionType
  quantityChange Float
  pricePerUnit   Float
  date           DateTime

  cryptoPosition CryptoPosition @relation(fields: [portfolioId, assetId], references: [portfolioId, assetId])

  @@index([id, portfolioId, assetId])
}

enum TransactionType {
  BUY
  SELL
}

enum CouponFrequency {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  MONTHLY
}

model Bond {
  id              String          @id @default(uuid())
  isin            String
  name            String
  faceValue       Float
  couponRate      Float
  couponFrequency CouponFrequency
  quantity        Float           @default(0)
  purchasePrice   Float           @default(0)
  currentValue    Float?
  purchaseDate    DateTime        @default(now())
  maturityDate    DateTime?

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId String
}

